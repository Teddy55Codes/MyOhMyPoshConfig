{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "console_title_template": "{{.UserName}}@{{.HostName}} in {{.PWD}}",
  "palette": {
    "os": "#acb0be",
    "pink": "#f5bde6",
    "lavender": "#b7bdf8",
    "violette": "#b581db",
    "blue":  "#8aadf4",
    "text": "#494d64",
    /* brand colors */
    "aspire-primary": "#7455dd",
    "clojure-primary": "#507dca",
    "cmake-primary": "#3dae2b",
    "crystal-primary": "#000000",
    "dart-primary": "#4c87f1",
    "dotnet-primary": "#7355dd",
    "elixir-primary": "#6e2e9e",
    "elixir-secondary": "#1a1221",
    "fortran-primary": "#734f96",
    "go-primary": "#007d9c",
    "haskell-primary": "#999999",
    "java-primary": "#f29111",
    "java-secondary": "#00758f",
    "julia-primary": "#4063d8",
    "kotlin-primary": "#6b57ff",
    "lua-primary": "#00007f",
    "mojo-primary": "#ee790b",
    "nim-primary": "#f3d400",
    "nim-secondary": "#171921",
    "node-primary": "#5fa04e",
    "ocaml-primary": "#ef7a08",
    "perl-primary": "#0073a1",
    "php-primary": "#4F5B93",
    "python-primary": "#3773a6",
    "python-secondary": "#ffd43b",
    "r-primary": "#2266b9",
    "ruby-primary": "#e2242a",
    "ruby-secondary": "#322e2b",
    "rust-primary": "#000000",
    "swift-primary": "#F05138",
    "v-primary": "#5d87bf",
    "vala-primary": "#7239b3",
    "xmake-primary": "#4acf93",
    "zig-primary": "#f7a41d",
    "zig-secondary": "#111111"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "background": "transparent",
          "foreground": "p:blue",
          "style": "plain",
          "template": "\u250f"
          
        },
        {
          "type": "text",
          "alias": "Heart",
          "background": "p:blue",
          "foreground_templates": [
            "{{ if .Root }}#ff0000{{ else }}#ffffff{{ end }}"
          ],
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\u2665 "
        },
        {
          "type": "text",
          "background": "p:blue",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": "​"
        },/* uncomment to enable LastFM
        {
          "type": "lastfm",
          "background": "p:violette",
          "foreground": "#ffffff",
          "options": {
            "api_key": "<YOUR_API_KEY>",
            "username": "<LASTFM_USERNAME>",
            "http_timeout": 20000
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "powerline",
          "template": " {{ .Icon }}{{ if ne .Status \"stopped\" }}{{ .Full }}{{ end }} "
        },*/
        {
          "type": "spotify",
          "background": "p:violette",
          "foreground": "#ffffff",
          "options": {
            "playing_icon": "\ue602 ",
            "paused_icon": "\uf04c ",
            "stopped_icon": "\uf04d ",
            "ad_icon": "\ueebb "
            },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "powerline"
        },
        {
          "type": "ytm",
          "background": "p:violette",
          "foreground": "#ffffff",
          "options": {
            "playing_icon": "\ue602 ",
            "paused_icon": "\uf04c ",
            "stopped_icon": "\uf04d ",
            "ad_icon": "\ueebb ",
            "http_timeout": 1000
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "powerline",
          "cache": {
            "duration": "5s",
            "strategy": "session"
          }
        },
        /* language/tool specific segements */
        {
          "type": "aspire",
          "background": "p:aspire-primary",
          "foreground": "#ffffff",
          "options": {
            "fetch_running": true
          },
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \uf4b7 {{ .Name }}{{ if .Running }} \uf04b{{ else }} \uf04c{{ end }} "
        },
        {
          "type": "clojure",
          "background": "p:clojure-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue768 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "cmake",
          "background": "p:cmake-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue794 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "crystal",
          "background": "#ffffff",
          "foreground": "p:crystal-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue7ac {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "dart",
          "background": "#0d1520",
          "foreground": "p:dart-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue64c {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "dotnet",
          "background": "p:dotnet-primary",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue77f {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "elixir",
          "background": "p:elixir-secondary",
          "foreground": "p:elixir-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue7cd {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "fortran",
          "background": "#ffffff",
          "foreground": "p:fortran-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue7de {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "go",
          "background": "p:go-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue627 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "haskell",
          "background": "#5e5086",
          "foreground": "p:haskell-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue777 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "java",
          "background": "p:java-secondary",
          "foreground": "p:java-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "julia",
          "background": "p:julia-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue80d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "kotlin",
          "background": "p:kotlin-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue634 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "lua",
          "background": "p:lua-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue620 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "mojo",
          "background": "p:mojo-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " 🔥 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "nim",
          "background": "p:nim-secondary",
          "foreground": "p:nim-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue841 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "node",
          "background": "p:node-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue718 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "ocaml",
          "background": "#ffffff",
          "foreground": "p:ocaml-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue84e {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "perl",
          "background": "p:perl-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue67e {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "php",
          "background": "p:php-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue73d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "python",
          "background": "p:python-primary",
          "foreground": "p:python-secondary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "r",
          "background": "#ffffff",
          "foreground": "p:r-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue881 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "ruby",
          "background": "p:ruby-secondary",
          "foreground": "p:ruby-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue605 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "rust",
          "background": "#ffffff",
          "foreground": "p:rust-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue68b {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "swift",
          "background": "#ffffff",
          "foreground": "p:swift-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue755 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "v",
          "background": "#ffffff",
          "foreground": "p:v-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue6ac {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "vala",
          "background": "p:vala-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue8d1 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "xmake",
          "background": "p:xmake-primary",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " xmake {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "zig",
          "background": "p:zig-secondary",
          "foreground": "p:zig-primary",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue6a9 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "sysinfo",
          "background": "p:lavender",
          "foreground": "p:text",
          "options": {
            "precision": 2
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \uefc5 {{ round .PhysicalPercentUsed .Precision }}% "
        },
        {
          "type": "battery",
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#33DD2D{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FFCD58{{end}}",
            "{{if eq \"Full\" .State.String}}#0476d0{{end}}"
          ],
          "foreground": "#242424",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{ if not .Error }}{{ .Percentage }}\uf295 {{ if ge .Percentage 95 }}󰁹{{ else if ge .Percentage 85 }}󰂂{{ else if ge .Percentage 75 }}󰂁{{ else if ge .Percentage 65 }}󰂀{{ else if ge .Percentage 55 }}󰁿{{ else if ge .Percentage 45 }}󰁾{{ else if ge .Percentage 35 }}󰁽{{ else if ge .Percentage 25 }}󰁼{{ else if ge .Percentage 15 }}󰁻{{ else if ge .Percentage 5 }}󰁺{{ else }}󱃍{{ end }}{{if eq \"Charging\" .State.String}}\ueb2d{{ end }} {{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "background": "transparent",
          "foreground": "p:blue",
          "style": "plain",
          "template": "\u2516"
        },
        {
          "type": "os",
          "background": "p:blue",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{.Icon}}  "
        },
        {
          "type": "session",
          "background": "p:blue",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "style": "diamond",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "path",
          "background": "p:pink",
          "foreground": "p:text",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short",
            "max_depth": 2
          },
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " {{ .Path }}"
        },
        {
          "type": "git",
          "background": "p:lavender",
          "foreground": "p:text",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "template": " {{ .HEAD }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "background": "p:lavender",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{ if matchP \"00:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue381{{ else if matchP \"12:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue381{{ else }}{{ end }}{{ if matchP \"01:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue382{{ else if matchP \"13:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue382{{ else }}{{ end }}{{ if matchP \"02:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue383{{ else if matchP \"14:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue383{{ else }}{{ end }}{{ if matchP \"03:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue384{{ else if matchP \"15:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue384{{ else }}{{ end }}{{ if matchP \"04:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue385{{ else if matchP \"16:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue385{{ else }}{{ end }}{{ if matchP \"05:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue386{{ else if matchP \"17:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue389{{ else }}{{ end }}{{ if matchP \"06:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue387{{ else if matchP \"18:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue387{{ else }}{{ end }}{{ if matchP \"07:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue388{{ else if matchP \"19:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue388{{ else }}{{ end }}{{ if matchP \"08:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue389{{ else if matchP \"20:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue389{{ else }}{{ end }}{{ if matchP \"09:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38a{{ else if matchP \"21:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38a{{ else }}{{ end }}{{ if matchP \"10:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38b{{ else if matchP \"22:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38b{{ else }}{{ end }}{{ if matchP \"11:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38c{{ else if matchP \"23:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38c{{ else }}{{ end }} {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "executiontime",
          "background": "#83769c",
          "foreground": "#ffffff",
          "options": {
            "always_enabled": true
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ueba2 {{ .FormattedMs }} "
        }
      ]
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "template": "<p:blue>\ue0b6</>{{ if .Root }}<#ff0000,p:blue>{{ else }}<#ffffff,p:blue>{{ end }}{{ .Segments.Heart.Segment.Text }} </><p:text,p:blue>{{ .Segments.Session.Segment.Text }}</><p:blue,p:pink>\ue0b4</><p:text,p:pink>{{ .Segments.Path.Segment.Text }}</>{{ if .Segments.Git.Segment.Text }}<p:pink,p:lavender>\ue0b4</>{{ else }}<p:pink,>\ue0b4</>{{ end }}<p:text,p:lavender>{{ .Segments.Git.Segment.Text }}</>{{ if .Segments.Git.Segment.Text }}<p:lavender>\ue0b4</>{{ end }} ",
    "right_template": "<p:lavender>\ue0b6</><p:text,p:lavender>{{ .Segments.Time.Segment.Text }}</><#83769c,p:lavender>\ue0b6</><#ffffff,#83769c>{{ .Segments.Executiontime.Segment.Text }}</>"
  },
  "final_space": true,
  "version": 4
}
