{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
        "os": "#ACB0BE",
        "pink": "#F5BDE6",
        "lavender": "#B7BDF8",
        "violette": "#b581db",
        "blue":  "#8AADF4",
        "white": "#FFFFFF",
        "text": "#494D64"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "background": "transparent",
          "foreground": "p:blue",
          "style": "plain",
          "template": "\u250f"
          
        },
        {
          "type": "text",
          "background": "p:blue",
          "foreground": "p:white",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "\u2665 "
        },
        {
          "type": "text",
          "background": "p:blue",
          "foreground": "p:white",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": "​"
        },
        {
          "type": "spotify",
          "background": "p:violette",
          "foreground": "#ffffff",
          "options": {
            "playing_icon": "\ue602 ",
            "paused_icon": "\uf04c ",
            "stopped_icon": "\uf04d ",
            "ad_icon": "\ueebb "
            },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "powerline"
        },
        {
          "type": "ytm",
          "background": "p:violette",
          "foreground": "#ffffff",
          "options": {
            "playing_icon": "\ue602 ",
            "paused_icon": "\uf04c ",
            "stopped_icon": "\uf04d ",
            "ad_icon": "\ueebb ",
            "http_timeout": 1000
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "powerline",
          "cache": {
            "duration": "5s",
            "strategy": "session"
          }
        },
        /* language specific segements */
        {
          "type": "clojure",
          "background": "#507dca",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue768 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "crystal",
          "background": "#ffffff",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue7ac {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "dart",
          "background": "#0d1520",
          "foreground": "#4c87f1",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue64c {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "dotnet",
          "background": "#7355dd",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue77f {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "elixir",
          "background": "#1a1221",
          "foreground": "#6e2e9e",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue7cd {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "fortran",
          "background": "#ffffff",
          "foreground": "#734f96",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue7de {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "go",
          "background": "#007d9c",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue627 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "haskell",
          "background": "#5e5086",
          "foreground": "#999999",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue777 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "java",
          "background": "#00758f",
          "foreground": "#f29111",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue738 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "julia",
          "background": "#4063d8",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue80d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "kotlin",
          "background": "#6b57ff",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue634 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "lua",
          "background": "#00007f",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue620 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "mojo",
          "background": "#ee790b",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " 🔥 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "nim",
          "background": "#171921",
          "foreground": "#f3d400",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue841 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "node",
          "background": "#5fa04e",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue718 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "ocaml",
          "background": "#ffffff",
          "foreground": "#ef7a08",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue84e {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "perl",
          "background": "#0073a1",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue67e {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "php",
          "background": "#4F5B93",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue73d {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "python",
          "background": "#ffd43b",
          "foreground": "#3773a6",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue235 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "r",
          "background": "#ffffff",
          "foreground": "#2266b9",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue881 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "ruby",
          "background": "#322e2b",
          "foreground": "#e2242a",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue605 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "rust",
          "background": "#ffffff",
          "foreground": "#000000",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue68b {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "swift",
          "background": "#ffffff",
          "foreground": "#F05138",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue755 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "v",
          "background": "#ffffff",
          "foreground": "#5d87bf",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue6ac {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "vala",
          "background": "#7239b3",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue8d1 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        },
        {
          "type": "zig",
          "background": "#111111",
          "foreground": "#f7a41d",
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " \ue6a9 {{ if .Error }}{{ .Error }}{{ else }}{{ .Full }}{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "sysinfo",
          "background": "p:lavender",
          "foreground": "p:text",
          "options": {
            "precision": 2
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "  {{ round .PhysicalPercentUsed .Precision }}% "
        },
        {
          "type": "battery",
          "background": "#f36943",
          "background_templates": [
            "{{if eq \"Charging\" .State.String}}#33DD2D{{end}}",
            "{{if eq \"Discharging\" .State.String}}#FFCD58{{end}}",
            "{{if eq \"Full\" .State.String}}#0476d0{{end}}"
          ],
          "foreground": "#242424",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{ if not .Error }}{{ .Percentage }}\uf295 {{ if ge .Percentage 95 }}󰁹{{ else if .Percentage ge 85 }}󰂂{{ else if .Percentage ge 75 }}󰂁{{ else if .Percentage ge 65 }}󰂀{{ else if .Percentage ge 55 }}󰁿{{ else if .Percentage ge 45 }}󰁾{{ else if .Percentage ge 35 }}󰁽{{ else if .Percentage ge 25 }}󰁼{{ else if .Percentage ge 15 }}󰁻{{ else if .Percentage ge 5 }}󰁺{{ else }}󱃍{{ end }}{{if eq \"Charging\" .State.String}}\ueb2d{{end}} {{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "background": "transparent",
          "foreground": "p:blue",
          "style": "plain",
          "template": "\u2516"
        },
        {
          "type": "os",
          "background": "p:blue",
          "foreground": "p:white",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{.Icon}}  "
        },
        {
          "type": "session",
          "background": "p:blue",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "style": "diamond",
          "template": "{{ .UserName }}@{{ .HostName }}"
        },
        {
          "type": "path",
          "background": "p:pink",
          "foreground": "p:text",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "agnoster_short",
            "max_depth": 2
          },
          "powerline_symbol": "\ue0b4",
          "style": "powerline",
          "template": " {{ .Path }}"
        },
        {
          "type": "git",
          "background": "p:lavender",
          "foreground": "p:text",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "style": "powerline",
          "powerline_symbol": "\ue0b4",
          "template": " {{ .HEAD }}"
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "time",
          "background": "p:lavender",
          "foreground": "p:text",
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{ if matchP \"00:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue381{{ else if matchP \"12:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue381{{ else }}{{ end }}{{ if matchP \"01:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue382{{ else if matchP \"13:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue382{{ else }}{{ end }}{{ if matchP \"02:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue383{{ else if matchP \"14:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue383{{ else }}{{ end }}{{ if matchP \"03:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue384{{ else if matchP \"15:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue384{{ else }}{{ end }}{{ if matchP \"04:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue385{{ else if matchP \"16:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue385{{ else }}{{ end }}{{ if matchP \"05:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue386{{ else if matchP \"17:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue389{{ else }}{{ end }}{{ if matchP \"06:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue387{{ else if matchP \"18:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue387{{ else }}{{ end }}{{ if matchP \"07:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue388{{ else if matchP \"19:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue388{{ else }}{{ end }}{{ if matchP \"08:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue389{{ else if matchP \"20:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue389{{ else }}{{ end }}{{ if matchP \"09:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38a{{ else if matchP \"21:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38a{{ else }}{{ end }}{{ if matchP \"10:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38b{{ else if matchP \"22:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38b{{ else }}{{ end }}{{ if matchP \"11:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38c{{ else if matchP \"23:.+:.+\" (localeShortTime .CurrentDate | date .Format) }}\ue38c{{ else }}{{ end }} {{ .CurrentDate | date .Format }} "
        },
        {
          "type": "executiontime",
          "background": "#83769c",
          "foreground": "#ffffff",
          "options": {
            "always_enabled": true
          },
          "powerline_symbol": "\ue0b4",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": " \ueba2 {{ .FormattedMs }} "
        }
      ]
    }
  ],
  "final_space": true,
  "version": 4
}
